! PV数据定义 - 方案B：激进型改造（1080kW总容量）
! 渗透率：61.0%

! 定义辐照度和温度曲线
New Loadshape.MyIrrad npts=360 sinterval=60 mult=(file=./loadshape/irrad_2025_02_0500_to_1659.csv) useactual=yes
New TShape.MyTemp npts=360 sinterval=60 temp=(file=./loadshape/temp.csv) useactual=yes


! 定义效率曲线
New XYCurve.MyEff npts=4 xarray=[.1 .2 .4 1.0] yarray=[.86 .9 .93 .97]
New XYCurve.MyPvsT npts=4 xarray=[0 25 75 100] yarray=[1.2 1.0 0.8 0.6]

! ========== 原有PV系统（540kW）==========
! PV834: 180kW @ 834节点
New PVSystem.PV834 phases=3 bus1=trafo_pv834 kV=0.48 kVA=200 irrad=1 Pmpp=180 temperature=25 
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV890: 180kW @ 890节点
New PVSystem.PV890 phases=3 bus1=trafo_pv890 kV=0.48 kVA=200 irrad=1 Pmpp=180 temperature=25 
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV864: 180kW @ 864节点
New PVSystem.PV864 phases=3 bus1=trafo_pv864 kV=0.48 kVA=200 irrad=1 Pmpp=180 temperature=25 
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! ========== 新增PV系统 - 方案B（540kW）==========
! PV844: 120kW @ 844节点（重负荷节点）
New PVSystem.PV844 phases=3 bus1=trafo_pv844 kV=0.48 kVA=133 irrad=1 Pmpp=120 temperature=25
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV848: 90kW @ 848节点（线路末端）
New PVSystem.PV848 phases=3 bus1=trafo_pv848 kV=0.48 kVA=100 irrad=1 Pmpp=90 temperature=25
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV832: 90kW @ 832节点（分支节点）
New PVSystem.PV832 phases=3 bus1=trafo_pv832 kV=0.48 kVA=100 irrad=1 Pmpp=90 temperature=25
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV856: 60kW @ 856节点（远端节点）
New PVSystem.PV856 phases=1 bus1=trafo_pv856 kV=0.277 kVA=67 irrad=1 Pmpp=60 temperature=25
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV840: 60kW @ 840节点（支线末端）
New PVSystem.PV840 phases=3 bus1=trafo_pv840 kV=0.48 kVA=67 irrad=1 Pmpp=60 temperature=25
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! PV822: 60kW @ 822节点（单相线路末端）
New PVSystem.PV822 phases=1 bus1=trafo_pv822 kV=0.277 kVA=67 irrad=1 Pmpp=60 temperature=25
~ PF=1.0 %cutin=0 %cutout=0
~ effcurve=Myeff P-TCurve=MyPvsT IrradShape=MyIrrad Tshape=MyTemp

! ========== 升压变压器定义 ==========
! 原有变压器
New Transformer.pv_up834 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv834 kV=0.48 kVA=300 conn=wye %r=0.5
~ wdg=2 bus=834 kV=24.9 kVA=300 conn=wye %r=0.5

New Transformer.pv_up890 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv890 kV=0.48 kVA=300 conn=wye %r=0.5
~ wdg=2 bus=890 kV=4.16 kVA=300 conn=wye %r=0.5

New Transformer.pv_up864 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv864 kV=0.48 kVA=300 conn=wye %r=0.5
~ wdg=2 bus=864.1 kV=24.9 kVA=300 conn=wye %r=0.5

! 新增变压器 - 方案B
New Transformer.pv_up844 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv844 kV=0.48 kVA=200 conn=wye %r=0.5
~ wdg=2 bus=844 kV=24.9 kVA=200 conn=wye %r=0.5

New Transformer.pv_up848 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv848 kV=0.48 kVA=150 conn=wye %r=0.5
~ wdg=2 bus=848 kV=24.9 kVA=150 conn=wye %r=0.5

New Transformer.pv_up832 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv832 kV=0.48 kVA=150 conn=wye %r=0.5
~ wdg=2 bus=832 kV=24.9 kVA=150 conn=wye %r=0.5

New Transformer.pv_up856 phases=1 xhl=4.5
~ wdg=1 bus=trafo_pv856 kV=0.277 kVA=100 conn=wye %r=0.5
~ wdg=2 bus=856.2 kV=14.376 kVA=100 conn=wye %r=0.5

New Transformer.pv_up840 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv840 kV=0.48 kVA=100 conn=wye %r=0.5
~ wdg=2 bus=840 kV=24.9 kVA=100 conn=wye %r=0.5

New Transformer.pv_up822 phases=1 xhl=4.5
~ wdg=1 bus=trafo_pv822 kV=0.277 kVA=100 conn=wye %r=0.5
~ wdg=2 bus=822.1 kV=14.376 kVA=100 conn=wye %r=0.5
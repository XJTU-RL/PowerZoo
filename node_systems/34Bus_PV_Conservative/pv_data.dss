! PV数据定义 - 方案C：保守型改造（720kW总容量）
! 渗透率：40.7%

! 定义辐照度和温度曲线
New Loadshape.MyIrrad npts=360 sinterval=60 mult=(file=./loadshape/irrad_2025_02_0500_to_1659.csv)
New Loadshape.MyTemp npts=360 sinterval=60 mult=(file=./loadshape/temp.csv)

! 定义效率曲线
New XYCurve.MyEff npts=4 xarray=[.1 .2 .4 1.0] yarray=[.86 .9 .93 .97]
New XYCurve.MyPvsT npts=4 xarray=[0 25 75 100] yarray=[1.2 1.0 0.8 0.6]

! ========== 原有PV系统（540kW）==========
! PV834: 180kW @ 834节点
New PVSystem.PV834 phases=3 bus1=trafo_pv834 kV=0.48 kVA=200 irrad=1.077 Pmpp=180 temperature=25 
~ PF=0.95 %cutin=0.05 %cutout=0.02
~ effcurve=Myeff P-TCurve=MyPvsT Duty=MyIrrad TDuty=MyTemp

! PV890: 180kW @ 890节点
New PVSystem.PV890 phases=3 bus1=trafo_pv890 kV=0.48 kVA=200 irrad=1.077 Pmpp=180 temperature=25 
~ PF=0.95 %cutin=0.05 %cutout=0.02
~ effcurve=Myeff P-TCurve=MyPvsT Duty=MyIrrad TDuty=MyTemp

! PV864: 180kW @ 864节点
New PVSystem.PV864 phases=3 bus1=trafo_pv864 kV=0.48 kVA=200 irrad=1.077 Pmpp=180 temperature=25 
~ PF=0.95 %cutin=0.05 %cutout=0.02
~ effcurve=Myeff P-TCurve=MyPvsT Duty=MyIrrad TDuty=MyTemp

! ========== 新增PV系统 - 方案C（180kW）==========
! PV844: 120kW @ 844节点（最重负荷点）
New PVSystem.PV844 phases=3 bus1=trafo_pv844 kV=0.48 kVA=133 irrad=1.077 Pmpp=120 temperature=25
~ PF=0.95 %cutin=0.05 %cutout=0.02
~ effcurve=Myeff P-TCurve=MyPvsT Duty=MyIrrad TDuty=MyTemp

! PV832: 60kW @ 832节点（关键分支点）
New PVSystem.PV832 phases=3 bus1=trafo_pv832 kV=0.48 kVA=67 irrad=1.077 Pmpp=60 temperature=25
~ PF=0.95 %cutin=0.05 %cutout=0.02
~ effcurve=Myeff P-TCurve=MyPvsT Duty=MyIrrad TDuty=MyTemp

! ========== 升压变压器定义 ==========
! 原有变压器
New Transformer.pv_up834 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv834 kV=0.48 kVA=300 conn=wye %r=0.5
~ wdg=2 bus=834 kV=24.9 kVA=300 conn=wye %r=0.5

New Transformer.pv_up890 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv890 kV=0.48 kVA=300 conn=wye %r=0.5
~ wdg=2 bus=890 kV=4.16 kVA=300 conn=wye %r=0.5

New Transformer.pv_up864 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv864 kV=0.48 kVA=300 conn=wye %r=0.5
~ wdg=2 bus=864.1 kV=24.9 kVA=300 conn=wye %r=0.5

! 新增变压器 - 方案C
New Transformer.pv_up844 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv844 kV=0.48 kVA=200 conn=wye %r=0.5
~ wdg=2 bus=844 kV=24.9 kVA=200 conn=wye %r=0.5

New Transformer.pv_up832 phases=3 xhl=4.5
~ wdg=1 bus=trafo_pv832 kV=0.48 kVA=100 conn=wye %r=0.5
~ wdg=2 bus=832 kV=24.9 kVA=100 conn=wye %r=0.5
Load.d844_846rb.vminpu=0.85
Load.d844_846sc.vminpu=0.85
Load.d844_846rc.vminpu=0.85
Load.d846_848sb.vminpu=0.85
Load.d846_848rb.vminpu=0.85

! ============================================================
! PV 系统 (5 units across 3 zones)
! ============================================================
! 每个 PV 通过升压变压器 (0.48kV -> 母线电压) 接入电网
! PV 功率由 pv_shape 曲线驱动，RL 环境可动态调整功率因数

! --- Zone 0: PV ---
! pv_d0_1: bus 822 (单相节点, phase 1), 200kW
New Transformer.pv_up_d0_1 Phases=1 Windings=2 Xhl=4.5
~ wdg=1 bus=pv_bus_d0_1 kV=0.277 kVA=250 conn=wye %r=0.5
~ wdg=2 bus=822.1       kV=14.376 kVA=250 conn=wye %r=0.5
New PVSystem.pv_d0_1 Phases=1 bus1=pv_bus_d0_1 kV=0.277 kVA=220 Pmpp=200
~ PF=1.0 %cutin=5 %cutout=2
~ effcurve=pv_eff P-TCurve=pv_ptc Duty=pv_shape TDuty=pv_temp

! pv_d0_2: bus 828 (三相节点), 200kW
New Transformer.pv_up_d0_2 Phases=3 Windings=2 Xhl=4.5
~ wdg=1 bus=pv_bus_d0_2 kV=0.48  kVA=300 conn=wye %r=0.5
~ wdg=2 bus=828         kV=24.9  kVA=300 conn=wye %r=0.5
New PVSystem.pv_d0_2 Phases=3 bus1=pv_bus_d0_2 kV=0.48 kVA=220 Pmpp=200
~ PF=1.0 %cutin=5 %cutout=2
~ effcurve=pv_eff P-TCurve=pv_ptc Duty=pv_shape TDuty=pv_temp

! --- Zone 1: PV ---
! pv_d1_1: bus 844 (三相节点), 200kW
New Transformer.pv_up_d1_1 Phases=3 Windings=2 Xhl=4.5
~ wdg=1 bus=pv_bus_d1_1 kV=0.48  kVA=300 conn=wye %r=0.5
~ wdg=2 bus=844         kV=24.9  kVA=300 conn=wye %r=0.5
New PVSystem.pv_d1_1 Phases=3 bus1=pv_bus_d1_1 kV=0.48 kVA=220 Pmpp=200
~ PF=1.0 %cutin=5 %cutout=2
~ effcurve=pv_eff P-TCurve=pv_ptc Duty=pv_shape TDuty=pv_temp

! pv_d1_2: bus 852 (三相节点), 200kW
New Transformer.pv_up_d1_2 Phases=3 Windings=2 Xhl=4.5
~ wdg=1 bus=pv_bus_d1_2 kV=0.48  kVA=300 conn=wye %r=0.5
~ wdg=2 bus=852         kV=24.9  kVA=300 conn=wye %r=0.5
New PVSystem.pv_d1_2 Phases=3 bus1=pv_bus_d1_2 kV=0.48 kVA=220 Pmpp=200
~ PF=1.0 %cutin=5 %cutout=2
~ effcurve=pv_eff P-TCurve=pv_ptc Duty=pv_shape TDuty=pv_temp

! --- Zone 2: PV ---
! pv_d2_1: bus 890 (三相节点, 4.16kV), 150kW
New Transformer.pv_up_d2_1 Phases=3 Windings=2 Xhl=4.5
~ wdg=1 bus=pv_bus_d2_1 kV=0.48  kVA=200 conn=wye %r=0.5
~ wdg=2 bus=890         kV=4.16  kVA=200 conn=wye %r=0.5
New PVSystem.pv_d2_1 Phases=3 bus1=pv_bus_d2_1 kV=0.48 kVA=165 Pmpp=150
~ PF=1.0 %cutin=5 %cutout=2
~ effcurve=pv_eff P-TCurve=pv_ptc Duty=pv_shape TDuty=pv_temp

! ============================================================
! Storage 储能系统 (3 units, one per zone)
! ============================================================
! 使用 OpenDSS 原生 Storage 元素
! %IdlingkW=1: 空闲损耗占额定功率的1%
! %reserve=10: 保留10%容量不放电
! State=IDLING: 初始为空闲状态, RL 环境运行时动态切换充放电

! --- Zone 0: ESS ---
! ess_d0: bus 824, 500kWh, 100kW max charge/discharge
New Storage.ess_d0 Phases=3 bus1=824 kV=24.9
~ kWRated=100 kWhRated=500 kWhStored=250
~ %reserve=10 %EffCharge=95 %EffDischarge=95
~ %IdlingkW=1 State=IDLING
~ Duty=flat_shape

! --- Zone 1: ESS ---
! ess_d1: bus 848, 500kWh, 100kW max charge/discharge
New Storage.ess_d1 Phases=3 bus1=848 kV=24.9
~ kWRated=100 kWhRated=500 kWhStored=250
~ %reserve=10 %EffCharge=95 %EffDischarge=95
~ %IdlingkW=1 State=IDLING
~ Duty=flat_shape

! --- Zone 2: ESS ---
! ess_d2: bus 888, 300kWh, 60kW max charge/discharge
New Storage.ess_d2 Phases=3 bus1=888 kV=4.16
~ kWRated=60 kWhRated=300 kWhStored=150
~ %reserve=10 %EffCharge=95 %EffDischarge=95
~ %IdlingkW=1 State=IDLING
~ Duty=flat_shape

! ============================================================
! EV 充电负荷 (2 units)
! ============================================================
! EV 负荷使用 ev_shape 曲线 (晚高峰集中充电)
! kW 为最大充电功率, 实际功率 = kW * ev_shape_mult
! RL 环境可通过设置 kW 实现充电调度

! --- Zone 0: EV ---
! ev_d0: bus 830, 50kW max
New Load.ev_d0 Bus1=830.1.2.3 Phases=3 Conn=Wye Model=1 kV=24.9 kW=50.0 kVAR=0.0 duty=ev_shape
Load.ev_d0.vminpu=0.85

! --- Zone 1: EV ---
! ev_d1: bus 854, 50kW max
New Load.ev_d1 Bus1=854.1.2.3 Phases=3 Conn=Wye Model=1 kV=24.9 kW=50.0 kVAR=0.0 duty=ev_shape
Load.ev_d1.vminpu=0.85

! ============================================================
! 虚拟功率交换元素 (台区间联络线建模)
! ============================================================
! 设计原理:
!   每条虚拟联络线用一对 Load + Generator 实现功率转移:
!   - Load 侧 (输出端): 从本台区抽取功率 (正kW = 输出)
!   - Generator 侧 (输入端): 向对方台区注入功率 (正kW = 注入)
!   初始 kW=0, 运行时由 RL 环境动态设置
!   正向功率流: A->B 时, Load.A 的 kW>0 且 Generator.B 的 kW>0
!   反向功率流: B->A 时, 取反即可
!   注意: 不考虑联络线损耗 (虚拟传输)

! --- tie_0_1: Zone 0 (bus 830) <-> Zone 1 (bus 854) ---
! 从 Zone 0 输出: 830 上的虚拟负荷 (吸收功率 = 输出到 Zone 1)
New Load.exchange_z0_to_z1 Bus1=830.1.2.3 Phases=3 Conn=Wye Model=1 kV=24.9 kW=0.0 kVAR=0.0 duty=flat_shape
Load.exchange_z0_to_z1.vminpu=0.85
! 向 Zone 1 注入: 854 上的虚拟发电机 (发出功率 = 从 Zone 0 接收)
New Generator.exchange_z1_from_z0 bus1=854.1.2.3 Phases=3 kV=24.9 kW=0.0 PF=1.0 conn=Wye Model=1

! --- tie_1_2: Zone 1 (bus 848) <-> Zone 2 (bus 890) ---
! 从 Zone 1 输出: 848 上的虚拟负荷
New Load.exchange_z1_to_z2 Bus1=848.1.2.3 Phases=3 Conn=Wye Model=1 kV=24.9 kW=0.0 kVAR=0.0 duty=flat_shape
Load.exchange_z1_to_z2.vminpu=0.85
! 向 Zone 2 注入: 890 上的虚拟发电机 (注意 4.16kV 电压等级)
New Generator.exchange_z2_from_z1 bus1=890.1.2.3 Phases=3 kV=4.16 kW=0.0 PF=1.0 conn=Wye Model=1

! ============================================================
! 仿真设置
! ============================================================
Set ControlMode=Static       ! 静态控制模式, 适合 RL 控制
Set MaxIterations=30         ! 最大迭代次数 (含 DER 后需更多迭代)

Set VoltageBases = "69, 24.9, 4.16, 0.48, 0.277"
CalcVoltageBases

BusCoords IEEE34_BusXY.csv

! 仿真模式: duty, 15分钟步长, 96步 = 24小时
Set mode=duty stepsize=900 number=1 hour=0 sec=0
Set SampleEnergyMeters=Yes

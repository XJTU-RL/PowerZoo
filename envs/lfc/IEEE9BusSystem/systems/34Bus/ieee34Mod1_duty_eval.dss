!new regcontrol.reg1c  transformer=reg1c winding=2  vreg=2196  band=20  ptratio=20 ctprim=700  R=3   X=9
! Regulator 2
new transformer.reg2a phases=1 windings=2 buses=(852.1 852r.1) conns='wye wye' kvs="43.2 43.2" kVAs=[499800 499800] XHL=0.01 %LoadLoss=0.01

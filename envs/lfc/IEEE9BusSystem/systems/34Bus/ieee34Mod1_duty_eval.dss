! 75/12.5 kV  Transformer
New Transformer.XFM1  Phases=3 Windings=2 Xhl=2
~ wdg=1 bus=832       conn=wye   kv=75  kva=150000    %r=.55     XHT=1
~ wdg=2 bus=888       conn=Wye   kv=12.5  kva=150000    %r=.55   XLT=1

! Regulators - three independent phases
! Regulator 1
new transformer.reg1a phases=1 windings=2 buses=(814.1 814r.1) conns='wye wye' kvs="43.2 43.2" kVAs=[499800 499800] XHL=0.01 %LoadLoss=0.01
!new regcontrol.reg1a  transformer=reg1a winding=2  vreg=2196  band=20  ptratio=20 ctprim=700  R=3   X=9 

new transformer.reg1b phases=1 windings=2 buses=(814.2 814r.2) conns='wye wye' kvs="43.2 43.2" kVAs=[499800 499800] XHL=0.01 %LoadLoss=0.01

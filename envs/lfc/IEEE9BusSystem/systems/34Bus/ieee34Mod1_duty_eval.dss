new transformer.reg2c phases=1 windings=2 buses=(852.3 852r.3) conns='wye wye' kvs="43.2 43.2" kVAs=[499800 499800] XHL=0.01 %LoadLoss=0.01
!new regcontrol.reg2c  transformer=reg2c winding=2  vreg=2196  band=20  ptratio=20 ctprim=700  R=3   X=9

